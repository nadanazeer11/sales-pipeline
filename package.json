{
  "name": "sales-pipeline",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sp/engine dev",
    "start": "pnpm --filter @sp/engine start",
    "cli": "pnpm --filter @sp/engine cli",
    "db:generate": "pnpm --filter @sp/core db:generate",
    "db:migrate": "pnpm --filter @sp/core db:migrate",
    "db:studio": "pnpm --filter @sp/core db:studio",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "web": "pnpm --filter @sp/web dev",
    "web:build": "pnpm --filter @sp/web build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.10.0",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
